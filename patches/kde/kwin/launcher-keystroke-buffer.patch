+/**
+ * Buffers keyboard events between a global launcher shortcut firing and the
+ * launcher window activating, then replays them cleanly to the launcher surface.
+ * Prevents fast post-Meta typing from leaking into the previously focused window.
+ */
+class LauncherKeyBufferFilter : public QObject, public InputEventFilter
+{
+    Q_OBJECT
+
+public:
+    explicit LauncherKeyBufferFilter(QObject *parent = nullptr)
+        : QObject(parent)
+        , InputEventFilter(InputFilterOrder::GlobalShortcut)
+    {
+        m_timeout.setSingleShot(true);
+        m_timeout.setInterval(1000ms);
+        connect(&m_timeout, &QTimer::timeout, this, &LauncherKeyBufferFilter::onTimeout);
+
+        setLauncherShortcutCallbacks([this] {
+            arm();
+        }, [this] {
+            cancel();
+        });
+        connect(workspace(), &Workspace::windowActivated, this, &LauncherKeyBufferFilter::onWindowActivated);
+#if KWIN_BUILD_SCREENLOCKER
+        if (kwinApp()->supportsLockScreen()) {
+            connect(ScreenLocker::KSldApp::self(), &ScreenLocker::KSldApp::lockStateChanged, this, &LauncherKeyBufferFilter::cancel);
+        }
+#endif
+    }
+
+    ~LauncherKeyBufferFilter() override
+    {
+        setLauncherShortcutCallbacks({}, {});
+    }
+
+    bool pointerButton(PointerButtonEvent *event) override
+    {
+        if (m_buffering && event->state == PointerButtonState::Pressed) {
+            cancel();
+        }
+        return false;
+    }
+
+    bool keyboardKey(KeyboardKeyEvent *event) override
+    {
+        if (!m_buffering) {
+            return false;
+        }
+
+        if (event->state == KeyboardKeyState::Pressed) {
+            m_bufferedPressedKeys.insert(event->nativeScanCode);
+            input()->keyboard()->addFilteredKey(event->nativeScanCode);
+            recordEvent(event);
+            return true;
+        }
+
+        if (!m_bufferedPressedKeys.contains(event->nativeScanCode)) {
+            // Release/repeat for a key pressed before the launcher shortcut (e.g. Meta or Alt+F1);
+            // let it pass through so the previous client does not get a stuck key.
+            return false;
+        }
+
+        if (event->state == KeyboardKeyState::Released) {
+            m_bufferedPressedKeys.remove(event->nativeScanCode);
+        }
+        recordEvent(event);
+        return true;
+    }
+
+private:
+    struct BufferedKeyEvent
+    {
+        uint32_t scanCode = 0;
+        KeyboardKeyState state = KeyboardKeyState::Pressed;
+        std::chrono::microseconds timestamp = std::chrono::microseconds::zero();
+        uint32_t modsDepressed = 0;
+        uint32_t modsLatched = 0;
+        uint32_t modsLocked = 0;
+        uint32_t group = 0;
+    };
+
+    void recordEvent(KeyboardKeyEvent *event)
+    {
+        const Xkb *xkb = input()->keyboard()->xkb();
+        const auto &modState = xkb->modifierState();
+        m_bufferedEvents.append(BufferedKeyEvent{
+            .scanCode = event->nativeScanCode,
+            .state = event->state,
+            .timestamp = event->timestamp,
+            .modsDepressed = modState.depressed,
+            .modsLatched = modState.latched,
+            .modsLocked = modState.locked,
+            .group = xkb->currentLayout(),
+        });
+    }
+
+    void arm()
+    {
+        if (m_buffering) {
+            // Double-tap before the launcher mapped cancels the open; drop buffered keys.
+            cancel();
+            return;
+        }
+        Window *active = workspace()->activeWindow();
+        if (active && (active->isAppletPopup() || active->resourceName() == QLatin1StringView("krunner"))) {
+            // Launcher is already open and focused, so this shortcut closes it.
+            return;
+        }
+        m_previousActiveWindow = active;
+        m_bufferedEvents.clear();
+        m_bufferedPressedKeys.clear();
+        m_buffering = true;
+        m_timeout.start();
+    }
+
+    void cancel()
+    {
+        m_buffering = false;
+        m_timeout.stop();
+        disconnect(m_pongConnection);
+        m_pongConnection = QMetaObject::Connection();
+        m_pendingPongSerial.reset();
+        m_pendingTargetWindow = nullptr;
+        m_previousActiveWindow = nullptr;
+        m_bufferedEvents.clear();
+        m_bufferedPressedKeys.clear();
+    }
+
+    void onTimeout()
+    {
+        if (!m_buffering) {
+            return;
+        }
+        if (m_pendingTargetWindow && m_pendingTargetWindow->surface()) {
+            flushToWindow(m_pendingTargetWindow);
+            return;
+        }
+        cancel();
+    }
+
+    void flushToWindow(Window *window)
+    {
+        if (!m_buffering) {
+            return;
+        }
+        const QList<BufferedKeyEvent> events = std::move(m_bufferedEvents);
+        cancel();
+
+        if (events.isEmpty() || !window || !window->surface()) {
+            return;
+        }
+
+        input()->keyboard()->update();
+        SeatInterface *seat = waylandServer()->seat();
+        if (seat->focusedKeyboardSurface() != window->surface()) {
+            return;
+        }
+
+        for (const BufferedKeyEvent &ev : events) {
+            seat->notifyKeyboardModifiers(ev.modsDepressed, ev.modsLatched, ev.modsLocked, ev.group);
+            seat->setTimestamp(ev.timestamp);
+            seat->notifyKeyboardKey(ev.scanCode, ev.state, waylandServer()->display()->nextSerial());
+        }
+
+        const Xkb *xkb = input()->keyboard()->xkb();
+        const auto &modState = xkb->modifierState();
+        seat->notifyKeyboardModifiers(modState.depressed, modState.latched, modState.locked, xkb->currentLayout());
+    }
+
+    void onWindowActivated(Window *window)
+    {
+        if (!m_buffering) {
+            return;
+        }
+        if (!window || window == m_previousActiveWindow || !window->surface()) {
+            return;
+        }
+        if (m_pendingTargetWindow == window && m_pendingPongSerial.has_value()) {
+            return;
+        }
+
+        input()->keyboard()->update();
+
+        // Wait for an xdg_wm_base ping/pong round-trip before replaying keys.
+        // QtWayland responds to wl_keyboard.enter by sending wl_display.sync and only
+        // posts QWindow::focusInEvent() (establishing QtQuick's activeFocusItem) when
+        // wl_callback.done arrives. Because the client queues wl_display.sync before
+        // xdg_wm_base.pong, replying to the sync happens strictly before pongReceived,
+        // guaranteeing replayed wl_keyboard.key events arrive after focusInEvent().
+        if (auto *toplevel = qobject_cast<XdgToplevelWindow *>(window)) {
+            if (XdgToplevelInterface *iface = toplevel->shellSurface()) {
+                if (XdgSurfaceInterface *xdgSurface = iface->xdgSurface()) {
+                    if (XdgShellInterface *shell = xdgSurface->shell()) {
+                        m_pendingTargetWindow = window;
+                        m_pendingPongSerial = shell->ping(xdgSurface);
+                        disconnect(m_pongConnection);
+                        m_pongConnection = connect(shell, &XdgShellInterface::pongReceived, this, [this](quint32 serial) {
+                            if (m_buffering && m_pendingPongSerial && serial == *m_pendingPongSerial) {
+                                flushToWindow(m_pendingTargetWindow);
+                            }
+                        });
+                        return;
+                    }
+                }
+            }
+        }
+
+        flushToWindow(window);
+    }
+
+    bool m_buffering = false;
+    QPointer<Window> m_previousActiveWindow;
+    QPointer<Window> m_pendingTargetWindow;
+    std::optional<quint32> m_pendingPongSerial;
+    QMetaObject::Connection m_pongConnection;
+    QList<BufferedKeyEvent> m_bufferedEvents;
+    QSet<uint32_t> m_bufferedPressedKeys;
+    QTimer m_timeout;
+};
 #endif
 
 namespace
