{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "mcp": {
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "type": "local"
    },
    "railway": {
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [],
  "providers": {
    "xiaomi": {
      "models": {
        "mimo-v2.6-pro": {
          "name": "MiMo-V2.6-Pro",
          "family": "mimo",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "mimo-v2.6-flash": {
          "name": "MiMo-V2.6-Flash",
          "family": "mimo",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "mimo-v2.6-pro-ultraspeed": {
          "name": "MiMo-V2.6-Pro-UltraSpeed",
          "family": "mimo",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    }
  },
  "provider": {
    "llama-local": {
      "models": {
        "gemma-4-12b-qat-mtp": {
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "name": "Gemma 4 12B (QAT, MTP)"
        }
      },
      "name": "llama.cpp (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      }
    },
    "opencode": {
      "models": {
        "kimi-k2.6": {
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "name": "Kimi K2.6"
        }
      }
    }
  }
}
