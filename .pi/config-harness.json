{
  "vitalFiles": [
    "flake.nix",
    "hosts/crystalheart/default.nix",
    "modules/nixos/common.nix",
    "home/answer/default.nix",
    "home/answer/dotfiles.nix",
    "README.md"
  ],
  "vitalFilesMaxBytes": 61440,
  "notesFile": ".pi/compaction.md",
  "notesMaxBytes": 4096,
  "diffCount": 3,
  "diffMaxBytes": 12288,
  "shadowDir": ".pi/shadow.git",
  "runtimeDir": ".pi/config-harness",
  "secretDenyPatterns": [
    "*.env",
    "*.key",
    "*.age"
  ],
  "check": {
    "command": "./scripts/check.sh",
    "enabled": true,
    "timeoutMs": 600000
  },
  "switch": {
    "timeoutMs": 60000,
    "title": "config-harness: activate NixOS configuration"
  },
  "recall": {
    "defaultLimit": 20,
    "maxLimit": 50
  }
}
